@page "/UpdateTask/{Id:int}"
@inject Services.TaskService _service;
@inject NavigationManager _NavigationManager;
@inject NotificationService _NotificationService
@inject Helper.MyTasksDBContext _context ;
@inject DialogService _DialogService
@inject IJSRuntime _IJSRuntime ;
@inject Services.SubTaskService _SubTaskService
@using Radzen;
@using Radzen.Blazor;



@if (ExistingTask == null)
{
    <RadzenAlert Style="margin: 20px">
        <RadzenIcon Icon="warning" Style="margin-right: 10px" />
        Task not found or loading...
    </RadzenAlert>
}

else
{

    <EditForm FormName="updatetask" Model="@ExistingTask" OnValidSubmit="UpdateTask">
        <ValidationSummary />
        <DataAnnotationsValidator />
        <RadzenCard>
            <RadzenRow Style="margin:10px">
                <RadzenColumn SizeMD="4">
                    <RadzenLabel Text="task name : " /> <br />
                    <RadzenTextBox @bind-Value="ExistingTask.TaskName" />
                </RadzenColumn>
                <RadzenColumn SizeMD="4">
                    <RadzenLabel Text="task description : " /><br />
                    <RadzenTextBox @bind-Value="ExistingTask.TaskDescription" />
                </RadzenColumn>
                <RadzenColumn SizeMD="4" Style="margin-left = 90px">
                    <br />
                    @if (ExistingTask.IsCompletedAfterSDeadline == false && ExistingTask.IsCompletedWithinSDeadline == false)
                    {

                        <RadzenButton Text="Mark Complete"
                        ButtonStyle="ButtonStyle.Success"
                        Click="@(() => ToggleTaskCompletion(ExistingTask))"
                        Style="margin-left:10px" />
                    }
                    else
                    {
                        <RadzenButton Text="Mark Incomplete"
                        ButtonStyle="ButtonStyle.Secondary"
                        Click="@(() => ToggleTaskCompletion(ExistingTask))"
                        Style="margin-left:10px" />
                    }

                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Style="margin:10px">
                <RadzenColumn SizeMD="4">
                    <RadzenLabel Text="task deadline : " /><br />
                    <RadzenDatePicker @bind-Value="ExistingTask.Deadline" />
                </RadzenColumn>
                <RadzenColumn SizeMD="4">
                    <RadzenLabel Text="task status : " /><br />
                    @if (AllStatus != null && AllStatus.Any())
                    {
                        <RadzenDropDown Data="@AllStatus"
                        AllowFiltering="true" AllowClear="true"
                        @bind-Value="ExistingTask.StatusId"
                        TextProperty="StatusName"
                        ValueProperty="StatusId"
                        Placeholder="Select Status" />
                    }
                    else
                    {
                        <p>Loading statuses...</p>
                    }
                </RadzenColumn>

            </RadzenRow>

            <RadzenRow Style="margin:10px">
                <RadzenColumn SizeMD="4">
                    <RadzenLabel Text="task Priorities : " /><br />
                    <RadzenDropDown Data="@AllPriorities"
                    AllowClear="true" AllowFiltering="true"
                    @bind-Value="ExistingTask.PriorityId"
                    TextProperty="PriorityName"
                    ValueProperty="PriorityId"
                    Placeholder="select priority" />
                </RadzenColumn>
                <RadzenColumn SizeMD="4">
                    <RadzenLabel Text="task Notifier : " /><br />
                    <RadzenDropDown Data="@NotifierOptions"
                    AllowClear="true"
                    AllowFiltering="true"
                    @bind-Value="ExistingTask.NotifierInHours"
                    TextProperty="DisplayText"
                    ValueProperty="Value"
                    Placeholder="Select notifier time" />
                </RadzenColumn>
                @* <RadzenColumn SizeMD="4"> *@
                @*     <RadzenLabel Text="task email : " /><br /> *@
                @*     <RadzenTextBox @bind-Value="ExistingTask.Email" /> *@
                @* </RadzenColumn> *@
            </RadzenRow>

            <RadzenRow Style="margin:10px">
                <RadzenColumn SizeMD="4">
                </RadzenColumn>
            </RadzenRow>

            @* <RadzenRow Style="margin:10px"> *@
            @*     <RadzenColumn SizeMD="4"> *@
            @*         <RadzenLabel Text="task sprint : " /> <br /> *@
            @*         <RadzenDropDown Data="@AllSprints" *@
            @*         AllowClear="true" *@
            @*         AllowFiltering="true" *@
            @*         @bind-Value="ExistingTask.SprintId" *@
            @*         TextProperty="SprintName" *@
            @*         ValueProperty="SprintId" *@
            @*         Placeholder="Select sprint time" /> *@
            @*     </RadzenColumn> *@
            @* </RadzenRow> *@

            <RadzenRow Style="margin:10px">
                <RadzenColumn SizeMD="12">
                    <RadzenLabel  />
                    @if (ExistingTask?.Subtasks != null && ExistingTask.Subtasks.Any())
                    {
                        @foreach (var subtask in ExistingTask.Subtasks.ToList())
                        {
                            <RadzenRow Style="margin:5px">
                                <RadzenColumn SizeMD="12">
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="() => DeleteExistingSubTask(subtask.SubTaskId)" />
                                    <RadzenTextBox @bind-Value="subtask.SubTaskName" />
                                </RadzenColumn>
                            </RadzenRow>
                        }
                    }
                    @foreach (var subtask in NewSubtasks)
                    {
                        <RadzenRow Style="margin:5px">
                            <RadzenColumn SizeMD="8">
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Secondary" Click="() => RemoveNewSubtask(subtask)" />
                                <RadzenTextBox @bind-Value="subtask.SubTaskName" />
                            </RadzenColumn>
                        </RadzenRow>
                    }
                    <RadzenButton Text="Add Subtask" ButtonStyle="ButtonStyle.Primary" Click="AddNewSubtask" Style="margin-top:10px" />
                </RadzenColumn>
            </RadzenRow>
            <div class="form-footer" style="margin-top:50px; text-align:center" >
                <RadzenButton ButtonType="ButtonType.Submit"
                Text="Save Changes"
                Icon="save"
                ButtonStyle="ButtonStyle.Primary"
                IsBusy="@IsBusy"
                Disabled="@IsBusy" />

                <RadzenButton Text="Back"
                ButtonStyle="ButtonStyle.Base"
                Click="@(() => _NavigationManager.NavigateTo("/alltasks"))"
                Style="margin-left:10px" />

                <RadzenButton Text="Delete Task"
                ButtonStyle="ButtonStyle.Secondary"
                Icon="delete"
                Click="@DeleteTask"
                Style="margin-left:10px" />
            </div>
        </RadzenCard>
    </EditForm>
    <div class="container">
        <p id="countdown" class="countclass"></p>

    </div>

}
<script>
    function startCountdown(deadline)
    {
    let countDownDate = new Date(deadline).getTime();

    let x = setInterval(function() {
    let now = new Date().getTime();
    let distance = countDownDate - now;

    if (distance <= 0)
    {
    clearInterval(x);
    document.getElementById("countdown").innerHTML = "Time's up!";
    return;
    }
    let days = Math.floor(distance / (1000 * 60 * 60 * 24)); 
    let hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)); 
    let minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)); 
    let seconds = Math.floor((distance % (1000 * 60)) / 1000); 


    document.getElementById("countdown").innerHTML = "Task Will end after " + days + " Days " + " : " + hours + " Hours" + " : " + minutes + " Minutes" + " : " + seconds + " Seconds";
    }, 500);
    }
</script>

