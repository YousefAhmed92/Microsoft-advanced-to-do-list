@code
{


    private Models.Tasks? ExistingTask;
    [Parameter]
    public int Id { get; set; }
    private bool IsBusy { get; set; } = false;
    private bool IsLoading { get; set; } = false;
    private bool showNotifierDialog = false;
    private int? SelectedNotifierTime;
    private string NotifierEmail = "";
    // private List<Models.Sprint> AllSprints;
    private List<Models.Status>? AllStatus;
    private List<Models.Priority>? AllPriorities;
    private List<Models.SubTask> NewSubtasks { get; set; } = new List<Models.SubTask>();
    private List<Models.NotifierOption> NotifierOptions = new List<Models.NotifierOption>
    {
        new Models.NotifierOption { DisplayText = "before .5 hour", Value = 2 },
        new Models.NotifierOption { DisplayText = "before 1 hours", Value = 3 },
        new Models.NotifierOption { DisplayText = "before 2 hours", Value = 4 }
    };
    // private List<Models.SprintTime> SprintTime = new List<Models.SprintTime>
    // {
    //     new Models.SprintTime { DisplayText = "3 days sprint", Value = 1 },
    //     new Models.SprintTime { DisplayText = "1 week sprint ", Value = 24 },
    //     new Models.SprintTime { DisplayText = "2 weeks sprint", Value = 48 }
    // };
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ExistingTask?.Deadline != null)
        {
            await _IJSRuntime.InvokeVoidAsync("startCountdown", ExistingTask.Deadline.Value.ToString("yyyy-MM-ddTHH:mm:ss"));
        }
    }
    public async Task LoadData()
    {
        try
        {
            AllStatus = _context.Status.ToList();
            AllPriorities = _context.Priority.ToList();
            ExistingTask = await _service.GetById(Id);
            if (ExistingTask is null) throw new Exception("not found");
        }
        catch(Exception ex)
        {
            Console.WriteLine($" data exception {ex.Message}");
            throw;
        }
        finally
        {
            IsBusy = false;
            IsLoading = false;
        }
    }
    public async Task UpdateTask()
    {
        try 
        {
            if (ExistingTask == null) Console.WriteLine("task is null");
            ExistingTask.LastUpdated = DateTime.Now;

            if (NewSubtasks.Any())
            {
                foreach (var subtask in NewSubtasks)
                {
                    subtask.SubTaskId = 0;
                    subtask.TaskId = ExistingTask.TaskId;
                    await _SubTaskService.Add(subtask);
                }
                NewSubtasks.Clear();

            }
            await _service.Update(ExistingTask);

            var message = new NotificationMessage
                {
                    Summary = "Changes Saved",
                    Detail = "Changes Saved Successfully",
                    Duration = 4000,
                    Severity = NotificationSeverity.Success
                };
            _NotificationService.Notify(message);

            // await _IJSRuntime.InvokeVoidAsync("playSuccessSound");
            // await Task.Delay(500);
            // _NavigationManager.NavigateTo("/alltasks");
        }
        catch (InvalidDataException iex)
        {
            var message = new NotificationMessage
                {
                    Summary = "validation error",
                    Detail = iex.Message,
                    Duration = 3000,
                    Severity = NotificationSeverity.Error
                };
            _NotificationService.Notify(message);
            // throw;
        }
        catch (Exception ex)
        {
            var message = new NotificationMessage
                {
                    Summary = "Vaildation error",
                    Detail = ex.Message,
                    Duration = 3000,
                    Severity = NotificationSeverity.Error
                };
            _NotificationService.Notify(message);
        }
        finally
        {
            IsBusy = false;
            IsLoading = false;
        }
    }



    private async Task ToggleTaskCompletion(Models.Tasks task)
    {
        try
        {
            var DaysLeft = (task.Deadline - DateTime.Now).Value.Days;

            if (DaysLeft == 0)
            {
                if (task.IsCompletedAfterSDeadline == false )
                {
                    task.IsCompletedAfterSDeadline = true;
                    task.SubmittedAt = DateTime.Now;
                    task.LastUpdated = DateTime.Now;

                }

            }

            if (task.Deadline == null)
            {
                if (task.IsCompletedAfterSDeadline == true || task.IsCompletedWithinSDeadline == true)
                {
                    bool? IsConfirmed = await _DialogService.Confirm
                    (
                        "are you sure you want to incomplete this task",
                        "Incomplete Task",
                        new ConfirmOptions()
                            {
                                OkButtonText = "Incomplete",
                                CancelButtonText = "Back"
                            }
                    );
                    if (IsConfirmed == true)
                    {
                        task.IsCompletedWithinSDeadline = false;
                        task.IsCompletedAfterSDeadline = false;
                        task.SubmittedAt = null;
                        task.LastUpdated = DateTime.Now;
                    }
                }
                else
                {
                    task.IsCompletedWithinSDeadline = true;
                    task.SubmittedAt = DateTime.Now;
                    var message = new NotificationMessage
                        {
                            Detail = "Task Completed Successfully ✅",
                            Duration = 5000,
                            Severity = NotificationSeverity.Success
                        };
                    _NotificationService.Notify(message);
                }
            }
            else
            {

                if (task.IsCompletedWithinSDeadline == true || task.IsCompletedAfterSDeadline == true)
                {
                    bool? IsConfirmed = await _DialogService.Confirm
                    (
                        "do you want to Incomplete this task ?",
                        "Incomplete task",
                        new ConfirmOptions()
                            {
                                OkButtonText = "Incomplete",
                                CancelButtonText = "Back"
                            }

                    );
                    if (IsConfirmed == true)
                    {
                        task.IsCompletedWithinSDeadline = false;
                        task.IsCompletedAfterSDeadline = false;
                        task.SubmittedAt = null;
                    }
                }
                else
                {
                    if (DaysLeft >= 0)
                    {
                        task.IsCompletedWithinSDeadline = true;
                        var message = new NotificationMessage
                            {
                                Detail = "Task Completed Successfully Within Deadline ✅",
                                Duration = 5000,
                                Severity = NotificationSeverity.Success

                            };
                        _NotificationService.Notify(message);
                    }
                    else
                    {
                        task.IsCompletedAfterSDeadline = true;
                    }
                    task.SubmittedAt = DateTime.Now;
                }
                task.LastUpdated = DateTime.Now;
            }
            await _service.UpdateTaskStatus(task);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            var message = new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Validation Error",
                    Detail = ex.Message,
                    Duration = 3000
                };
            _NotificationService.Notify(message);
        }
    }
    private async Task DeleteTask()
    {
        try
        {
            bool? IsConfirmed = await _DialogService.Confirm
            (
                "Are you sure you want to delete this task?",
                "delete task",
                new ConfirmOptions()
                    {
                        OkButtonText = "Delete",
                        CancelButtonText = "cancle",
                    }
            );
            Console.WriteLine($"Confirm result: {IsConfirmed}");
            StateHasChanged();  

            if (IsConfirmed == true)
            {
                await _service.Delete(Id);
                var message = new NotificationMessage
                {
                    Detail = "task deleted",
                    Summary =  "task deleted successfully",
                    Duration = 3000,
                    Severity = NotificationSeverity.Warning

                };
                _NavigationManager.NavigateTo("/alltasks");

            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Delete failed: {ex.Message}");
            throw;
        }
    }
