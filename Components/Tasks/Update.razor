    void AddNewSubtask()
    {

        NewSubtasks?.Add(new Models.SubTask { SubTaskName = "" });
    }
    void RemoveNewSubtask(Models.SubTask subtask)
    {
        NewSubtasks?.Remove(subtask);
    }
    private async Task DeleteExistingSubTask(int id)
    {
        try
        {
            bool? IsConfirmed = await _DialogService.Confirm(
                "Are you sure you want to delete this subtask?",
                "delete task",
                new ConfirmOptions()
                    {
                        OkButtonText = "Delete",
                        CancelButtonText = "cancle",
                    }
        );
            Console.WriteLine($"Confirm result: {IsConfirmed}");
            StateHasChanged();
            if (IsConfirmed == true)
            {
                await _SubTaskService.Delete(id);
                var message = new NotificationMessage
                    {
                        Detail = "task deleted",
                        Summary = "task deleted successfully",
                        Duration = 3000
                    };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Delete failed: {ex.Message}");
            throw;
        }
    }
    private string ButtonColor(Models.Tasks task)
    {
        if (task.IsCompletedAfterSDeadline == false && task.IsCompletedWithinSDeadline == false)
        {
            return "ButtonStyle.Success";

        }
        else return "ButtonStyle.Danger";
    }
}
