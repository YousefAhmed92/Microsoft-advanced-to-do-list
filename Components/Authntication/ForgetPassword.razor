@page "/ForgetPassword"
@inject NavigationManager _NavigationManager
@inject DialogService _DialogService
@inject Services.AccountService _service ;
@inject NotificationService _NotificationService
@using Radzen;
@using Radzen.Blazor;


<EditForm Model="@forgetPasswordModel" OnValidSubmit="HandleForgotPassword" FormName="forgetpassword">
    <RadzenCard>
        <RadzenRow Style="margin-top:15px">
            <RadzenColumn>
                <RadzenLabel Text="enter your email" /> <br />
                <RadzenTextBox Placeholder="Email" @bind-Value="forgetPasswordModel.Email" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Style="margin-top:15px">
            <RadzenButton Text="send" ButtonStyle="ButtonStyle.Secondary" ButtonType="ButtonType.Submit" />
        </RadzenRow>

    </RadzenCard>
</EditForm>

@code {
    string email;

    public ForgetPasswordModel forgetPasswordModel = new();

    public Models.User user = new();

    async Task HandleForgotPassword()
    {
        try 
        {
            await _service.ForgetPassword(forgetPasswordModel.Email);
            EmailSendingConfirmation();
            // _NavigationManager.NavigateTo($"/resetpassword?email={Uri.EscapeDataString(forgetPasswordModel.Email)}");
        }
        catch(InvalidDataException iex)
        {
            var message = new NotificationMessage
            {
                Detail = iex.Message,
                Summary = "failed !",
                Duration = 5000
            };
            _NotificationService.Notify(message);
        }
    }


    public void EmailSendingConfirmation()
    {
        _DialogService.Confirm
        (
            "The Reset Password Link is sent to the email you entered now",
            "confirm",
            new ConfirmOptions{
                OkButtonText = "ok"
            }
        );

    }

    public class ForgetPasswordModel
    {
        public string Email { get; set; }
    }
}