@page "/resetpassword"
@inject NavigationManager _NavigationManager
@inject Services.AccountService _service ;
@inject NotificationService _NotificationService
@using Radzen;
@using Radzen.Blazor

<EditForm Model="@resetPasswordmodel" OnValidSubmit="ResetPassword" FormName="resetPassword">
    <RadzenCard>
        <RadzenRow Style="margin-top:15px">
            <RadzenTextBox Placeholder="Email" @bind-Value="resetPasswordmodel.email" Disabled="true" />
        </RadzenRow>
        <RadzenRow Style="margin-top:15px">
            <RadzenPassword Placeholder="New Password" @bind-Value="resetPasswordmodel.NewPassword" />
        </RadzenRow>
        <RadzenRow Style="margin-top:15px">
            <RadzenPassword Placeholder="Confirm New Password" @bind-Value="resetPasswordmodel.ConfirmPassword" />
        </RadzenRow>
        <RadzenRow Style="margin-top:15px">
            <RadzenButton Text="Reset Password" ButtonStyle="ButtonStyle.Secondary" ButtonType="ButtonType.Submit" />
        </RadzenRow>
    </RadzenCard>
</EditForm>

@code{
    string newPassword;
    string confirmPassword;
    public Models.User user;


    public ResetPasswordModel resetPasswordmodel = new();

    public string email { get; set; }
    public string token { get; set; }



    protected override void OnInitialized()
    {
        var uri = new Uri(_NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        resetPasswordmodel.email = query.Get("email");
        resetPasswordmodel.Token = query.Get("token");

        Console.WriteLine($"Email: {resetPasswordmodel.email}, Token: {resetPasswordmodel.Token}"); 
    }
    async Task ResetPassword()
    {
        try
        {
            await _service.ResetPassword(resetPasswordmodel.Token, resetPasswordmodel.NewPassword, resetPasswordmodel.ConfirmPassword);
            _NavigationManager.NavigateTo("/");
            StateHasChanged();
        }
        catch(InvalidDataException iex)
        {
            var message = new NotificationMessage
            {
                Detail= iex.Message,
                Summary = "failed reset password",
                Duration = 5000,
                Severity = NotificationSeverity.Error
            };
            _NotificationService.Notify(message);
        }
        catch(Exception ex)
        {
            var message = new NotificationMessage
                {
                    Detail = ex.Message,
                    Summary = "failed reset password",
                    Duration = 5000,
                    Severity = NotificationSeverity.Error
                };
            _NotificationService.Notify(message);
        }
        // if (resetPasswordmodel.NewPassword == resetPasswordmodel.ConfirmPassword)
        // {
            // var success = await _service.ResetPassword(resetPasswordmodel.Token, resetPasswordmodel.NewPassword, resetPasswordmodel.ConfirmPassword);
            // if (success)
            //     _NavigationManager.NavigateTo("/");
            //     StateHasChanged();
        // }
        // else{
        //     Console.WriteLine("sss");
        // }
    }

    public class ResetPasswordModel
    {
        public string email { get; set; }
        public string Token { get; set; }
        public string NewPassword { get; set; }
        public string ConfirmPassword { get; set; }
    }
}